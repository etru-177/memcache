      "targets": [
        {
          "expr": "memcache_client_bandwidth_bytes_cum_total{rank=~\"$rank\"} / (memcache_client_bandwidth_duration_ms_cum_total{rank=~\"$rank\"} / 1000)",
          "legendFormat": "{{operation}} @ {{rank}}",
          "refId": "A"
        }
      ],
      "title": "Cumulative Bandwidth (Lifetime Avg Bps)",
      "type": "timeseries",
      "description": "累计带宽 = cumTotalBytes / (cumTotalDurationMs / 1000)，生命周期平均吞吐率(Bps)，无IO时除零无线。支持 $rank 过滤",
      "datasource": "${datasource}"
    }
